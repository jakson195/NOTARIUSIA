# Chave da API da Anthropic (Claude). Obtenha em console.anthropic.com
ANTHROPIC_API_KEY=

# Segredo usado para assinar a sessão de login. Gere um valor aleatório
# longo (ex: rode `openssl rand -base64 32` no terminal, ou use qualquer
# gerador de senha forte) e NUNCA reutilize entre ambientes.
AUTH_SECRET=

# Token do Vercel Blob (armazenamento de arquivos). Necessário para o
# upload de PDFs/imagens funcionar. Na Vercel, é gerado automaticamente ao
# criar um Blob Store em Storage → Create Database → Blob e conectar ao
# projeto. Para rodar localmente, copie o valor gerado lá.
BLOB_READ_WRITE_TOKEN=

# Banco de dados. Use a connection string de um Postgres real (Neon,
# Supabase, Vercel Postgres etc.) — SQLite não funciona em produção na
# Vercel (sem disco persistente) nem suporta os enums usados no schema.
DATABASE_URL="postgresql://usuario:senha@host:5432/notariusia"

# Necessário quando conectar autenticação real e/ou Stripe (ver README.md)
# NEXTAUTH_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
