# Chave da API da Anthropic (Claude). Obtenha em console.anthropic.com
ANTHROPIC_API_KEY=

# Banco de dados. Para desenvolvimento local com SQLite:
DATABASE_URL="file:./dev.db"
# Para produção, troque o provider no prisma/schema.prisma para "postgresql"
# e use algo como:
# DATABASE_URL="postgresql://usuario:senha@host:5432/notariusia"

# Necessário quando conectar autenticação real e/ou Stripe (ver README.md)
# NEXTAUTH_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
